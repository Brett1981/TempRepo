{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=Sage200APIMSAdvanced;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Sage": {
    "DefaultSite": "MainSite",
    "DefaultCompanyId": "SAGE200UK",
    "ApiBaseUrl": "https://api.columbus.sage.com/uk/sage200/v1",
    "ClientId": "YOUR_CLIENT_ID",
    "ClientSecret": "YOUR_CLIENT_SECRET",
    "TokenEndpoint": "https://oauth.columbus.sage.com/token"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "GroupId": "sage200microservice_requests",
    "AutoOffsetReset": "Earliest",
    "EnableAutoCommit": false,
    "Topics": {
      "Invoice": "MDM_INVOICE",
      "InvoiceResults": "MDM_INVOICE_RESULTS",
      "Customer": "MDM_CUSTOMER",
      "CustomerResults": "MDM_CUSTOMER_RESULTS",
      "SopOrder": "MDM_SOP_ORDER",
      "SopResults": "MDM_SOP_RESULTS",
      "Payments": "MDM_PAYMENTS",
      "PaymentResults": "MDM_PAYMENT_RESULTS",
      "Dlq": "MDM_DLQ"
    }
  },
  "ApiSecurity": {
    "RequireHttps": true,
    "AllowedOrigins": [ "http://localhost:3000", "https://yourdomain.com" ],
    "RateLimiting": {
      "RequestsPerMinute": 100
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/sage200microservice-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  }
}
